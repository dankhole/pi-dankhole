{
  "name": "pi-dankhole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi customizations: plain workers, questions and interface styling.",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "biome check src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:workers && npm run test:interface",
    "test:workers": "vitest run",
    "test:interface": "node --test tests/interface/*.test.mjs",
    "build": "tsc",
    "migration:status": "node scripts/migration-status.mjs",
    "bench:workers": "vitest bench tests/workers/perf/spawn.bench.ts",
    "bench:interface": "node scripts/bench-interface.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.5.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "typebox": "^1.3.27",
    "typescript": "^6.0.0",
    "vitest": "4.1.11"
  }
}
